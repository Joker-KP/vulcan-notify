VULCAN_BROWSER_HEADLESS=false
VULCAN_BROWSER_PROFILE_DIR=/app/data/chromium-profile
VULCAN_BROWSER_LOCK_FILE=/app/data/chromium-profile.lock
VULCAN_BROWSER_SLOW_MO_MS=0

VULCAN_LOGIN_DELAY_SECONDS=2

VULCAN_CAPTCHA_DETECT_TIMEOUT_SECONDS=5
VULCAN_CAPTCHA_COMPLETE_TIMEOUT_SECONDS=60


# SQLite database path
DB_PATH=vulcan_notify.db

# Session file path (cookies from browser login)
# SESSION_FILE=session.json

# Auto-login credentials (optional - browser reuse before credential login)
# When set, the script auto-reauthenticates when session expires
# VULCAN_LOGIN=your.email@example.com
# VULCAN_PASSWORD=your_password

# Message sender whitelist (comma-separated, empty = show all)
# Only messages from matching senders are displayed (case-insensitive substring match)
# MESSAGE_SENDER_WHITELIST=Smith,Jones

# AI summary (optional - leave LLM_API_KEY empty to disable)
# LLM_BASE_URL=https://api.cerebras.ai/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-oss-120b
# PROMPTS_FILE=prompts.toml

# Email change digests over SMTP (disabled by default; see docs/email.md)
EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=school@example.org
# SMTP_PASSWORD=your_smtp_password
# SMTP_TIMEOUT_SECONDS=30
# EMAIL_FROM="Some One <school@example.org>"
# EMAIL_TO=["parent@example.org"]
# EMAIL_SUBJECT_PREFIX=eduVULCAN
# Message bodies are excluded unless explicitly enabled.
# EMAIL_INCLUDE_MESSAGE_BODIES=false
# Replace the plain digest with the existing AI summary (also requires LLM_API_KEY).
# Only explicitly enabling this sends the email summary input to the configured LLM.
# EMAIL_AI_SUMMARY=false
# EMAIL_AI_TIMEOUT_SECONDS=30

# ntfy.sh push notifications (used by deploy script and future notification features)
# NTFY_TOPIC=vulcan-notify
# NTFY_SERVER=https://ntfy.sh

# Short names for push notifications (canonical full name -> nickname)
# Keeps the title terse on watch/lock-screen. JSON object.
# DISPLAY_NAME_MAP={"Solomiia Senyuk": "Solya"}

# Logging level
LOG_LEVEL=INFO

# Docker deployment: override paths to use persistent volume
# DB_PATH=/app/data/vulcan_notify.db
# SESSION_FILE=/app/data/session.json

# Service scheduling and freshness (the container clock stays UTC)
POLL_INTERVAL=1800
QUIET_HOURS_START=0
QUIET_HOURS_END=5
QUIET_HOURS_TZ=Europe/Warsaw
STALE_AFTER_SECONDS=3600
SYNC_HISTORY_KEEP_DAYS=90
