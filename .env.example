# Copy to .env. Compose exports these variables to all three containers.
# Python Settings also loads .env; direct auth/API/shell readers need exported
# variables when running outside Docker. Uncomment optional settings as needed.
# Lists and maps use JSON, with synthetic names/addresses in the examples below.

# Timezone shared by Docker, Python/shell logs, Chromium, quiet hours, email,
# MQTT timestamps, API diagnostics and local date windows. Uses DST rules.
# Use a valid IANA name. TZ takes precedence over the legacy QUIET_HOURS_TZ alias.
# Database timestamps remain UTC for compatibility with existing history;
# iCalendar and upstream requests encode UTC instants where required.
TZ=Europe/Warsaw

# Local storage. Compose overrides both paths to the persistent /app/data volume.
DB_PATH=vulcan_notify.db
SESSION_FILE=session.json

# Authentication: reuse saved cookies/profile before credential login.
# Optional credentials enable automatic recovery when a session expires.
# Without credentials, use the explicit auth command for manual authentication.
# VULCAN_LOGIN=parent@example.org
# VULCAN_PASSWORD=replace_me

# Headed Chromium under Xvfb is the default; interactive auth is always headed.
VULCAN_BROWSER_HEADLESS=false
# Persistent browser state and shared lock; stop sync before interactive auth.
# Compose fixes these paths for both browser services. Direct readers need exports.
VULCAN_BROWSER_PROFILE_DIR=/app/data/chromium-profile
VULCAN_BROWSER_LOCK_FILE=/app/data/chromium-profile.lock
# Playwright delay per browser action, in milliseconds; 0 disables it.
VULCAN_BROWSER_SLOW_MO_MS=0
# Wait after credential submission, in seconds.
VULCAN_LOGIN_DELAY_SECONDS=2
# CAPTCHA detection and completion deadlines, in seconds.
VULCAN_CAPTCHA_DETECT_TIMEOUT_SECONDS=5
VULCAN_CAPTCHA_COMPLETE_TIMEOUT_SECONDS=60
# Xvfb display; Compose fixes :99 for the worker and interactive auth.
# DISPLAY=:99

# Synchronization coverage and scheduling.
# Attendance lookback in days. Messages: missing historical bodies per sync.
SYNC_ATTENDANCE_DAYS=90
SYNC_MESSAGE_BACKFILL_BATCH=10
# Delay after each sync completes, in seconds (not a fixed start-to-start period).
POLL_INTERVAL=1800
# Hours 0-23 in TZ; start inclusive, end exclusive. Equal values disable pauses.
# Windows crossing midnight are supported. MQTT heartbeat continues while paused.
QUIET_HOURS_START=0
QUIET_HOURS_END=5
# Freshness threshold in seconds, excluding scheduled quiet hours.
STALE_AFTER_SECONDS=3600
# Retain sync-run/section diagnostics for this many days; entity history is kept.
SYNC_HISTORY_KEEP_DAYS=90

# HTTP API (direct environment reader). Defaults to port 8585.
# Compose publishes 8585:8585; changing API_PORT also requires editing the port
# mapping and healthcheck. /api/alive is liveness; /api/health is data freshness.
# API_PORT=8585
# Enable HTTP access logs; disabled by default to reduce polling noise.
# API_ACCESS_LOG=false

# Logging verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL. Timestamps use TZ.
LOG_LEVEL=INFO

# Message display filter: JSON list of case-insensitive sender substrings.
# Empty list shows all. Filtering affects display, not storage/email/MQTT.
# MESSAGE_SENDER_WHITELIST=["Teacher One","Teacher Two"]

# MQTT change events, new messages and retained heartbeat (disabled by default).
MQTT_ENABLED=false
# Host reachable from the container; localhost refers to the container itself.
# MQTT_BROKER=mqtt.example.org
# MQTT_PORT=1883
# Optional broker credentials.
# MQTT_USERNAME=vulcan-notify
# MQTT_PASSWORD=replace_me
# Event topic root; heartbeat/LWT is <prefix>/<status suffix>.
# MQTT_TOPIC_PREFIX=school
# MQTT_STATUS_SUFFIX=status
# Short student names in MQTT payloads; JSON object of full name -> nickname.
# DISPLAY_NAME_MAP={"Example Student":"Alex"}

# SMTP email: per-sync change digest and separate new-message/praise/note emails.
# Disabled by default; configuration and delivery limits are in docs/email.md.
EMAIL_ENABLED=false
# Required when enabled: SMTP_HOST, EMAIL_FROM and nonempty EMAIL_TO.
# SMTP_HOST=smtp.example.org
# Transport: starttls (usually 587), ssl (usually 465), none (plain relay).
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# Optional authentication; set username/password together or leave both unset.
# SMTP_USERNAME=school@example.org
# SMTP_PASSWORD=replace_me
# Socket-operation timeout, in seconds; must be positive.
# SMTP_TIMEOUT_SECONDS=30
# Sender accepts a bare address or a display name; recipients are bare addresses.
# EMAIL_FROM="School notifications <school@example.org>"
# EMAIL_TO=["parent@example.org"]
# Digest subject prefix, followed by present groups and the total change count.
# EMAIL_SUBJECT_PREFIX="[eduVulcan]"
# Include/exclude groups in the change digest only; omitted keys stay enabled.
# Keys: grade, attendance, substitution, cancellation, addition, exam, homework.
# EMAIL_DIGEST_GROUPS={"attendance":false,"homework":false}
# Separate message subject: this prefix followed by the original subject.
# EMAIL_MESSAGE_SUBJECT_PREFIX="[Nowa wiadomość]"
# Separate praise/note subject: this prefix, student name and category.
# Full note content and student-view link are always included.
# EMAIL_REMARK_SUBJECT_PREFIX="[Uwagi]"
# Include inbox message bodies (off by default); does not control note content.
# EMAIL_INCLUDE_MESSAGE_BODIES=false
# Add an AI summary above the HTML change groups; requires LLM_API_KEY below.
# Only the student-change digest goes to the LLM; messages/notes are excluded.
# EMAIL_AI_SUMMARY=false
# AI preparation timeout in seconds; failures keep the grouped digest.
# EMAIL_AI_TIMEOUT_SECONDS=30

# Optional AI summaries via an OpenAI-compatible provider. Leave the key unset
# to disable. A key enables the summarize CLI command.
# AI email digests additionally require EMAIL_AI_SUMMARY=true above.
# LLM_BASE_URL=https://api.cerebras.ai/v1
# LLM_API_KEY=replace_me
# LLM_MODEL=gpt-oss-120b
# Prompt templates, relative to the working directory unless absolute.
# PROMPTS_FILE=prompts.toml

# macOS Calendar via AppleScript: exams/homework, separate from the schedule ICS.
# Keep empty in Linux/Docker; requires existing calendars on macOS.
# JSON object mapping student full name to calendar name. Empty disables it.
# CALENDAR_MAP={}
# CALENDAR_MAP={"Example Student":"School Alex"}
# Reminder lead time, in hours before each event.
# CALENDAR_REMINDER_HOURS=24
# Deadline per AppleScript operation; timed-out processes are killed and reaped.
# Transient update/deletion failures retain the event UID for the next retry.
# CALENDAR_TIMEOUT_SECONDS=30

# Deployment-script ntfy alerts; no adapter for synchronized school changes.
# NTFY_TOPIC=vulcan-notify
# NTFY_SERVER=https://ntfy.sh
